{
  "name": "pdl145t-backend",
  "version": "0.1.0",
  "description": "PDL-145T — Backend API pour l'enregistrement des nouveau-nés (RDC)",
  "main": "dist/app.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "db:migrate": "ts-node node_modules/.bin/knex --knexfile src/database/knexfile.ts migrate:latest",
    "db:rollback": "ts-node node_modules/.bin/knex --knexfile src/database/knexfile.ts migrate:rollback",
    "db:seed": "ts-node node_modules/.bin/knex --knexfile src/database/knexfile.ts seed:run",
    "db:init": "npm run db:migrate && npm run db:seed",
    "db:reset": "ts-node node_modules/.bin/knex --knexfile src/database/knexfile.ts migrate:rollback --all && npm run db:init",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "date-fns": "^3.6.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "sqlite3": "^6.0.1",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/qrcode": "^1.5.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
